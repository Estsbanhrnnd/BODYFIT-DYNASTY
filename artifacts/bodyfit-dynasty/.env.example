# BodyFit Dynasty - Mobile App (Expo) Environment Configuration

# Clave pública de Clerk para React Native / Expo
# Obtenla en tu Dashboard de Clerk (formato pk_test_... o pk_live_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Dominio del backend Express
# Para emulador Android: 10.0.2.2:5000
# Para teléfono físico en la misma red Wi-Fi: <TU_IP_LOCAL>:5000 (ejemplo: 192.168.1.15:5000)
# Para desarrollo web o túnel: localhost:5000
EXPO_PUBLIC_DOMAIN=localhost:5000

# Activa el modo de desarrollo/demo si no hay claves reales configuradas aún
EXPO_PUBLIC_DEV_MODE=true

# Claves de RevenueCat (opcionales durante desarrollo en Expo Go)
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
