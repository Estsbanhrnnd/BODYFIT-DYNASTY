# BodyFit Dynasty - Backend Environment Configuration

# Puerto del servidor (por defecto 5000)
PORT=5000

# Cadena de conexión de PostgreSQL (ejemplo con Neon.tech o Supabase):
# DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/bodyfit?sslmode=require
DATABASE_URL=

# Credenciales de Clerk (Backend)
CLERK_SECRET_KEY=

# Clave de OpenAI para el análisis de alimentos por cámara (gpt-4o-mini)
OPENAI_API_KEY=

# Modo de desarrollo: omitir comprobación estricta de Clerk si no hay claves
DEV_BYPASS_AUTH=true
